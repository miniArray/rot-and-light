[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../target/debug/librot_and_light_godot.so"
linux.release.x86_64 = "res://../target/release/librot_and_light_godot.so"
linux.debug.arm64 = "res://../target/debug/librot_and_light_godot.so"
linux.release.arm64 = "res://../target/release/librot_and_light_godot.so"
windows.debug.x86_64 = "res://../target/debug/rot_and_light_godot.dll"
windows.release.x86_64 = "res://../target/release/rot_and_light_godot.dll"
macos.debug = "res://../target/debug/librot_and_light_godot.dylib"
macos.release = "res://../target/release/librot_and_light_godot.dylib"
