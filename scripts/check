#!/usr/bin/env -S nix shell nixpkgs#bash --command bash
# Run through `nix run .#check` for the repository's pinned toolchain.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
# The .gdextension descriptor loads the binding from this exact directory.
export CARGO_TARGET_DIR="$PWD/target"

check_source() {
  : "${EXPECTED_SOURCE_SHA:?Set EXPECTED_SOURCE_SHA to the full committed source SHA}"
  [[ "$EXPECTED_SOURCE_SHA" =~ ^[0-9a-f]{40}$ ]] || {
    echo "check: EXPECTED_SOURCE_SHA must be a full commit SHA" >&2
    exit 1
  }
  test "$(git rev-parse HEAD)" = "$EXPECTED_SOURCE_SHA"
  git diff --quiet HEAD -- || {
    echo "check: commit tracked changes before building the pinned source" >&2
    exit 1
  }
}

check_source
python3 tests/test_godot_runner.py
cargo fmt --all -- --check
check_source
cargo clippy --workspace --all-targets --locked -- -D warnings
check_source
cargo test --workspace --locked
check_source
cargo build --workspace --locked
bash scripts/test-godot
